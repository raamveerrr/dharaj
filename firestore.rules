rules_version = '2';

// Dharaj — Firestore Security Rules
// Deploy from the Firebase console (Firestore → Rules) or via `firebase deploy --only firestore:rules`.
//
// Authorization model:
//   users/{uid}.role is "customer" | "admin"
//   Only admins may read/write store-management collections.
//   A user can never change their own role (prevents privilege escalation).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Self-signup: may only create own doc, and only as a customer.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'customer';

      // Self-update: cannot change own role. Admins may change roles.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role)
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ---------- public catalogue (read-only for everyone) ----------
    match /products/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /homepage/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /homepageHero/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /homepageAnnouncements/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /homepageSettings/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /featuredProducts/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /featuredCategories/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{doc}    { allow read: if true; allow write: if isAdmin(); }

    // ---------- reviews ----------
    match /reviews/{doc} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- orders ----------
    match /orders/{doc} {
      // Customers read only their own orders; admins read everything.
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);

      // A customer may create their own order, always starting unpaid + pending.
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.paymentStatus == 'Awaiting Payment'
        && request.resource.data.orderStatus == 'Pending';

      // Owners may only flag that WhatsApp was opened. Status fields are admin-only.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.orderStatus == resource.data.orderStatus
          && request.resource.data.total == resource.data.total
          && request.resource.data.customerId == resource.data.customerId
        );

      allow delete: if isAdmin();
    }

    // ---------- order-number counter ----------
    match /counters/{doc} {
      allow read, write: if isSignedIn();
    }

    // ---------- admin-only collections ----------
    match /inventory/{doc} { allow read, write: if isAdmin(); }
    match /analytics/{doc} { allow read, write: if isAdmin(); }
    match /settings/{doc}  { allow read, write: if isAdmin(); }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
